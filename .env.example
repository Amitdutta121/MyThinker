OPENROUTER_API_KEY=
OPENROUTER_MODEL=~openai/gpt-latest
OPENROUTER_APP_URL=http://localhost:8501
OPENROUTER_APP_TITLE=MyThinking
OPENROUTER_DATA_COLLECTION=deny

MYTHINKING_DATA_DIR=data
MYTHINKING_PROMPT_DIR=prompts
MYTHINKING_MAX_TOKENS=4096
MYTHINKING_MAX_RETRIES=2
MYTHINKING_TEMPERATURE=0.2

# Optional: research retriever. Default is keyless DuckDuckGo.
# MYTHINKING_RESEARCH_RETRIEVER=tavily
# TAVILY_API_KEY=

# Optional: retrieval embeddings (used once a project grows past the threshold).
# MYTHINKING_EMBEDDING_MODEL=openai/text-embedding-3-small
# MYTHINKING_EMBEDDING_DIMENSIONS=1536
# MYTHINKING_CONTEXT_RETRIEVAL_THRESHOLD=20
# MYTHINKING_CONTEXT_RETRIEVAL_TOP_K=6

# Optional: cross-project user-profile extraction. Off by default.
# MYTHINKING_ENABLE_PROFILE_EXTRACTION=true

# Optional MLflow tracing. Needs `uv sync --group observability`.
# MYTHINKING_MLFLOW_TRACING=true
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# MYTHINKING_MLFLOW_EXPERIMENT=mythinking
