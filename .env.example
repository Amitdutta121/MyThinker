OPENROUTER_API_KEY=
OPENROUTER_MODEL=~openai/gpt-latest
OPENROUTER_APP_URL=http://localhost:8501
OPENROUTER_APP_TITLE=MyThinking
OPENROUTER_DATA_COLLECTION=deny

MYTHINKING_DATA_DIR=data
MYTHINKING_PROMPT_DIR=prompts
MYTHINKING_MAX_TOKENS=4096
MYTHINKING_MAX_RETRIES=2
MYTHINKING_TEMPERATURE=0.2

# Optional MLflow tracing. Needs `uv sync --group observability`.
# MYTHINKING_MLFLOW_TRACING=true
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# MYTHINKING_MLFLOW_EXPERIMENT=mythinking
